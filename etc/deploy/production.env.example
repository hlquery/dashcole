NODE_ENV=production
PORT=7000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=dashcole
MYSQL_USER=dashcole
MYSQL_PASSWORD=CHANGE_ME
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
DATABASE_REGION=cl-santiago
# Optional dedicated control plane. Leave empty to bootstrap in the main DB,
# then set these values after creating dashcole_control and migrating the tables.
CONTROL_MYSQL_DATABASE=
CONTROL_MYSQL_HOST=
CONTROL_MYSQL_PORT=
CONTROL_MYSQL_USER=
CONTROL_MYSQL_PASSWORD=
CONTROL_MYSQL_SSL=false
CONTROL_MYSQL_SSL_REJECT_UNAUTHORIZED=true
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=https://www.hlquery.com,https://hlquery.com,https://dashboard.hlquery.com,https://guias.hlquery.com
SCHOOL_NAME=DashCole
PLATFORM_ADMIN_EMAIL=super@hlquery.com
SYNC_TARGET=web
SYNC_PATH=/home/web/www
BACKUPS_ENABLED=true
SIGE_JOBS_ENABLED=true
DEMO_RESET_ENABLED=true
DEMO_RESET_EVERY_HOURS=10
# Optional public demo: sync2 --demo creates /home/web/www/dashboard/.demo
# (read-only only for dashboard.hlquery.com; www + guias stay fully writable).
# DEMO_MODE=true
BACKUP_ROOT=/home/web/www/backups
UPLOAD_DIR=/home/web/www/api/uploads
# SMTP is optional. Leave fields empty/null to disable mail (deploy will not fail).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DashCole <no-reply@hlquery.com>
# WhatsApp: plantilla aprobada con dos parámetros de texto en el cuerpo: asunto y mensaje.
# El token permanece exclusivamente en el servidor.
WHATSAPP_SCHOOL_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=es_CL
# 32-byte base64 key used to encrypt per-tenant integration secrets.
CONFIG_ENCRYPTION_KEY=
