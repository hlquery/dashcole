server {
    listen 80;
    listen [::]:80;
    server_name hlquery.com www.hlquery.com;
    return 301 https://www.hlquery.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name hlquery.com www.hlquery.com;

    root /home/web/www/web;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/www.hlquery.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.hlquery.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
