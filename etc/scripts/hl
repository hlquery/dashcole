#!/usr/bin/env bash
#
# hl — sincroniza DashCole hacia /home/cferry/p para publicar en GitHub:
#   hlquery/api      ← api/
#   hlquery/dashcole ← monorepo open source
#
# Uso:
#   ./etc/scripts/hl              # ambos repos
#   ./etc/scripts/hl api          # solo API
#   ./etc/scripts/hl dashcole     # solo plataforma
#   ./etc/scripts/hl --list
#
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRC_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
DEST_DIR="${HL_DEST_DIR:-/home/cferry/p}"
GIT_CLONE_DEPTH="${HL_GIT_CLONE_DEPTH:-0}"
NO_SHELL_AFTER_DEPLOY=0
SUPPRESS_STATS=0
STATS_ONLY=0
SHELL_DEST_DIR="$DEST_DIR"

declare -a REPO_ORDER=(api dashcole)
declare -A REPOS=(
  [api]="git@github.com:hlquery/api.git"
  [dashcole]="git@github.com:hlquery/dashcole.git"
)

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[✓]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[!]${NC} $1"; }
log_error() { echo -e "${RED}[✗]${NC} $1"; }

usage() {
  cat <<EOF
hl — sync DashCole → ${DEST_DIR} (repos públicos hlquery/api y hlquery/dashcole)

Uso:
  hl                 Sincroniza api + dashcole
  hl api             Solo el repo de la API
  hl dashcole        Solo el monorepo DashCole
  hl --list          Lista repos
  hl --stats         Solo estadísticas locales en ${DEST_DIR}
  hl --no-shell      No abrir shell al terminar
  hl --no-stats      Sin resumen de commits
  hl -h|--help

Variables:
  HL_DEST_DIR=/home/cferry/p
  HL_GIT_CLONE_DEPTH=0   (usa >0 para clone shallow)
EOF
}

list_repos() { printf '%s\n' "${REPO_ORDER[@]}"; }

print_completion() {
  cat <<'EOF'
_hl_complete() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local words="-h --help --list --stats --no-shell --no-stats api dashcole"
  COMPREPLY=( $(compgen -W "$words" -- "$cur") )
}
complete -F _hl_complete hl
EOF
}

print_repository_statistics() {
  local repo_name repo_dir commits branch last_commit files size
  echo ""
  echo "Repository statistics (${DEST_DIR})"
  printf '%-16s %10s %-14s %-12s %10s %10s\n' "Repository" "Commits" "Branch" "Last commit" "Files" "Size"
  printf '%-16s %10s %-14s %-12s %10s %10s\n' "----------------" "----------" "--------------" "------------" "----------" "----------"
  for repo_name in "${selected_repos[@]}"; do
    repo_dir="$DEST_DIR/$repo_name"
    [[ -d "$repo_dir/.git" ]] || continue
    commits="$(git -C "$repo_dir" rev-list --count HEAD 2>/dev/null || echo 0)"
    branch="$(git -C "$repo_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '-')"
    last_commit="$(git -C "$repo_dir" log -1 --format=%cs 2>/dev/null || echo '-')"
    files="$(git -C "$repo_dir" ls-files 2>/dev/null | wc -l | tr -d ' ')"
    size="$(du -sh "$repo_dir" 2>/dev/null | awk '{print $1}')"
    printf '%-16s %10s %-14s %-12s %10s %10s\n' "$repo_name" "$commits" "$branch" "$last_commit" "$files" "$size"
  done
  echo ""
}

configure_git_branch_tracking() {
  local clone_depth="$1"
  git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
  if [[ "$clone_depth" -eq 0 ]]; then
    git fetch origin "+refs/heads/*:refs/remotes/origin/*" >/dev/null 2>&1 || true
  else
    git fetch --depth "$clone_depth" origin "+refs/heads/*:refs/remotes/origin/*" >/dev/null 2>&1 \
      || git fetch origin "+refs/heads/*:refs/remotes/origin/*" >/dev/null 2>&1 || true
  fi
}

setup_repository() {
  local repo_name="$1"
  local repo_url="$2"
  local repo_dest="$DEST_DIR/$repo_name"
  local clone_args=()

  mkdir -p "$DEST_DIR"
  if [[ -d "$repo_dest/.git" ]]; then
    log_info "Repository exists: $repo_name"
    (
      cd "$repo_dest"
      configure_git_branch_tracking "$GIT_CLONE_DEPTH"
      git remote set-url origin "$repo_url" >/dev/null 2>&1 || true
    )
    return 0
  fi

  if [[ -d "$repo_dest" ]]; then
    log_warn "Removing non-git directory $repo_dest"
    rm -rf "$repo_dest"
  fi

  log_info "Cloning $repo_name from $repo_url"
  if [[ "$GIT_CLONE_DEPTH" -gt 0 ]]; then
    clone_args=(--depth "$GIT_CLONE_DEPTH")
  fi
  if git clone "${clone_args[@]}" "$repo_url" "$repo_dest"; then
    (
      cd "$repo_dest"
      configure_git_branch_tracking "$GIT_CLONE_DEPTH"
      if git show-ref --verify --quiet refs/remotes/origin/main; then
        git checkout -B main --track origin/main >/dev/null 2>&1 || git checkout main >/dev/null 2>&1 || true
      elif git show-ref --verify --quiet refs/remotes/origin/master; then
        git checkout -B master --track origin/master >/dev/null 2>&1 || true
      fi
    )
    log_success "Cloned $repo_name"
  else
    # Repo vacío o sin commits: init local apuntando al remoto
    log_warn "Clone vacío/fallido; inicializando $repo_name localmente"
    mkdir -p "$repo_dest"
    (
      cd "$repo_dest"
      git init -b main >/dev/null
      git remote add origin "$repo_url" 2>/dev/null || git remote set-url origin "$repo_url"
    )
    log_success "Initialized empty $repo_name → $repo_url"
  fi
}

clean_repository() {
  local repo_dest="$1"
  [[ -d "$repo_dest/.git" ]] || { log_error "Not a git repository: $repo_dest"; return 1; }
  log_info "Cleaning $(basename "$repo_dest") (keeping .git)..."
  (
    cd "$repo_dest"
    find . -maxdepth 1 -not -name '.' -not -name '.git' -exec rm -rf {} + 2>/dev/null || true
  )
  log_success "Cleaned $(basename "$repo_dest")"
}

rsync_tree() {
  local src="$1"
  local dest="$2"
  shift 2
  mkdir -p "$dest"
  rsync -a --delete \
    --exclude='.git/' \
    --exclude='node_modules/' \
    --exclude='**/node_modules/' \
    --exclude='dist/' \
    --exclude='**/dist/' \
    --exclude='.vite/' \
    --exclude='uploads/' \
    --exclude='**/uploads/' \
    --exclude='backups/' \
    --exclude='**/*.sqlite' \
    --exclude='**/*.sqlite3' \
    --exclude='.env' \
    --exclude='.env.*' \
    --exclude='!.env.example' \
    --exclude='!.env*.example' \
    "$@" \
    "$src" "$dest"
}

deploy_api() {
  local repo_dest="$DEST_DIR/api"
  log_info "Deploying API package → $repo_dest"
  if [[ ! -d "$SRC_DIR/api" ]]; then
    log_error "Missing $SRC_DIR/api"
    return 1
  fi
  rsync_tree "$SRC_DIR/api/" "$repo_dest/" \
    --exclude='data/' \
    --exclude='coverage/' \
    --exclude='.nyc_output/'
  # README corto si no hay uno propio en api/
  if [[ ! -f "$repo_dest/README.md" ]]; then
    cat >"$repo_dest/README.md" <<'EOF'
# DashCole API

API Express/MySQL/Redis para [DashCole](https://github.com/hlquery/dashcole).

```bash
npm install
npm run start
```

Ver el monorepo DashCole para instalación completa (`docker compose`, web y landing).
EOF
    log_success "Added default README.md"
  fi
  log_success "API synced"
}

deploy_dashcole() {
  local repo_dest="$DEST_DIR/dashcole"
  log_info "Deploying DashCole monorepo → $repo_dest"
  rsync_tree "$SRC_DIR/" "$repo_dest/" \
    --exclude='target/' \
    --exclude='propuesta/' \
    --exclude='todo.md' \
    --exclude='.cursor/' \
    --exclude='agent-transcripts/' \
    --exclude='guias/dist/' \
    --exclude='docs/dist/' \
    --exclude='landing/dist/' \
    --exclude='web/dist/' \
    --exclude='api/uploads/' \
    --exclude='api/data/' \
    --exclude='backups/' \
    --exclude='*.log'
  log_success "DashCole synced"
}

deploy_files() {
  case "$1" in
    api) deploy_api ;;
    dashcole) deploy_dashcole ;;
    *) log_warn "Unknown repository type: $1" ;;
  esac
}

main() {
  local all_repos=0
  local -a selected_repos=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --all) all_repos=1 ;;
      --no-shell) NO_SHELL_AFTER_DEPLOY=1 ;;
      --no-stats) SUPPRESS_STATS=1 ;;
      --stats) STATS_ONLY=1 ;;
      --list) list_repos; exit 0 ;;
      --completion) print_completion; exit 0 ;;
      api|dashcole) selected_repos+=("$1") ;;
      *)
        log_error "Unknown argument: $1"
        usage
        exit 1
        ;;
    esac
    shift
  done

  if [[ ${#selected_repos[@]} -eq 0 ]]; then
    all_repos=1
  fi
  if [[ "$all_repos" -eq 1 ]]; then
    selected_repos=("${REPO_ORDER[@]}")
  fi

  if [[ "$STATS_ONLY" -eq 1 ]]; then
    print_repository_statistics
    exit 0
  fi

  if [[ "$all_repos" -eq 0 && ${#selected_repos[@]} -eq 1 ]]; then
    SHELL_DEST_DIR="$DEST_DIR/${selected_repos[0]}"
  else
    SHELL_DEST_DIR="$DEST_DIR"
  fi

  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  DashCole → ${DEST_DIR} (hlquery/api · hlquery/dashcole)"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  Source: $SRC_DIR"
  echo ""

  mkdir -p "$DEST_DIR"
  log_success "Destination ready: $DEST_DIR"

  if [[ "$all_repos" -eq 1 ]]; then
    log_info "Syncing: ${selected_repos[*]}"
  else
    log_info "Selected: ${selected_repos[*]}"
  fi
  echo ""

  local repo_name
  for repo_name in "${selected_repos[@]}"; do
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    log_info "Processing: $repo_name"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    setup_repository "$repo_name" "${REPOS[$repo_name]}" || continue
    clean_repository "$DEST_DIR/$repo_name" || continue
    deploy_files "$repo_name"
    echo ""
  done

  log_info "Cleaning temporary files..."
  for repo_name in "${selected_repos[@]}"; do
    [[ -d "$DEST_DIR/$repo_name" ]] || continue
    find "$DEST_DIR/$repo_name" -type f \( -name '*.bak' -o -name '*.old' -o -name '*.tmp' \) -delete 2>/dev/null || true
  done
  log_success "Done"

  echo ""
  log_info "Published trees:"
  for repo_name in "${selected_repos[@]}"; do
    [[ -d "$DEST_DIR/$repo_name/.git" ]] && echo "  • $DEST_DIR/$repo_name  →  ${REPOS[$repo_name]}"
  done
  echo ""
  log_info "Siguiente paso (en cada repo): git add -A && git commit && git push -u origin main"
  echo ""

  if [[ "$SUPPRESS_STATS" -eq 0 ]]; then
    print_repository_statistics
  fi
}

main "$@"

if [[ ! -d "$SHELL_DEST_DIR" ]]; then
  SHELL_DEST_DIR="$DEST_DIR"
fi

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  if [[ "$NO_SHELL_AFTER_DEPLOY" -eq 1 ]]; then
    exit 0
  fi
  echo ""
  log_info "Changing to: $SHELL_DEST_DIR"
  cd "$SHELL_DEST_DIR" || exit 1
  exec "${SHELL:-bash}" -l
fi
